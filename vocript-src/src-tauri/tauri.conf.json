{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoCript",
  "version": "3.7.10",
  "identifier": "com.vocript.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: blob:; media-src 'self' asset: https://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false,
        "scope": {
          "allow": [],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": ["resources/**/*"],
    "license": "MIT",
    "publisher": "VoCript",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libgtk-layer-shell0", "libc6 (>= 2.39)"],
        "files": {
          "/usr/lib/VoCript": "transcribe-libs"
        }
      },
      "rpm": {
        "compression": {
          "type": "none"
        },
        "depends": [
          "libc.so.6(GLIBC_2.39)(64bit)",
          "libasound.so.2()(64bit)",
          "libgtk-layer-shell.so.0()(64bit)"
        ],
        "files": {
          "/usr/lib/VoCript": "transcribe-libs"
        }
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib": "transcribe-libs"
        }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGNzczOUU0REVFODVGRDEKUldUUlgramU1RGwzbnh5UFFwSk5WRjRyVXRRU1d0TlYvTVdneDVBOUljWlRZV0pHOWhkRGRSZU4K",
      "endpoints": [
        "https://github.com/Mun1to/Vocript/releases/latest/download/latest.json"
      ]
    }
  }
}
